# Copy this file to `.env` and set your timezone.
#
#   cp .env.example .env
#
# Sprout works out what "this month" is from the container's clock, so this has
# to match the timezone you actually live in — otherwise the budget rolls over
# to the next month early, and shows the wrong month for part of every day.
#
# Use a name from the IANA list, not an abbreviation like PST:
# https://en.wikipedia.org/wiki/List_of_tz_database_time_zones
#
# Not sure what yours is? If you have Node installed:
#   node -e "console.log(Intl.DateTimeFormat().resolvedOptions().timeZone)"

TZ=America/Los_Angeles
