{
  "name": "budget-app",
  "private": true,
  "version": "0.6.2",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "node server/index.js --port 3178",
    "dev:web": "vite --configLoader native",
    "build": "vite build --configLoader native",
    "start": "node server/index.js",
    "test:security": "node test-security.mjs",
    "test:sync": "node test-sync.mjs",
    "test:transfers": "node test-transfers.mjs",
    "test:categorization": "node test-categorization.mjs",
    "test:loan-payments": "node test-loan-payments.mjs",
    "test:bulk-delete": "node test-bulk-delete.mjs",
    "test:account-delete": "node test-account-delete.mjs",
    "test:changelog": "node test-changelog.mjs",
    "test:goals": "node test-goals.mjs",
    "test:recover": "node test-recover.mjs",
    "test:cashflow": "node test-cashflow.mjs",
    "seed": "node seed-testing-data.mjs"
  },
  "dependencies": {
    "@simplewebauthn/server": "^13.3.2",
    "better-sqlite3-multiple-ciphers": "^12.11.1",
    "express": "^4.21.2",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "vite": "^6.1.0"
  }
}
